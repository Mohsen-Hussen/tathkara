# Postgres connection (Neon, Supabase, RDS, or the docker-compose database)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tathkara

# Required in production — generate each with: openssl rand -base64 48
JWT_SECRET=
WEBHOOK_SECRET=

# Optional
PORT=4000
LOG_LEVEL=info
# Creates demo users and events on first boot when the database is empty
SEED_ON_START=true
